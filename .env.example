# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=advocate_system
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=1d

# File Upload Configuration
UPLOAD_DIR=uploads

# Mail Configuration
SMTP_HOST=your_smtp_host
SMTP_PORT=your_smtp_port
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
FROM_NAME=Advocate Management System
FROM_EMAIL=noreply@yourdomain.com
SMTP_SERVICE=gmail

FRONTEND_URL=http://150.241.247.100:5000

# Alohaa Call API Configuration
ALOHAA_API_KEY=your_alohaa_api_key_here

# CORS allowlist (comma separated). Default: https://pro.lawfyco.com,
# https://www.lawfyco.com, https://lawfyco.com and FRONTEND_URL (+ localhost:5173 outside production)
# CORS_ORIGINS=https://pro.lawfyco.com,https://www.lawfyco.com,https://lawfyco.com

# Only used when NO super-admin exists yet (first boot). If unset, a random
# password is generated and printed once in the server log. Min 12 chars.
# SUPER_ADMIN_PASSWORD=

# Express "trust proxy" setting (default: loopback, i.e. the local nginx)
# TRUST_PROXY=loopback
